{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Naima",
  "version": "1.2.0",
  "identifier": "org.naima-project.naima",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "deno task build",
    "beforeDevCommand": ""
  },
  "app": {
    "windows": [{ "create": false, "label": "main", "title": "Naima", "width": 1280, "height": 860, "minWidth": 320, "minHeight": 480 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; frame-src naima-files: http://naima-files.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
