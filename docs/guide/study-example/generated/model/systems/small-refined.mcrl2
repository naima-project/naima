%
% A client asks for the lock when it neither holds it nor waits for it, and lets it go
% when it holds it. Those are the inputs. When the lock is free and someone waits, the
% lock grants it to the client that has waited longest: that is the output.

sort Client = struct c1 | c2 | c3;              % the clients
sort Phase = struct IDLE | WAITING | HOLDING;   % where a client stands

act  c_ask, c_release: Client;                  % inputs, from the clients
     c_grant: Client;                           % the lock's own output

% phase: each client's phase; queue: the clients waiting, the longest first;
% free: nobody holds the lock
% ---- the policy's maps and the reference definitions of the selection operations
% (docs/spec.md §3.7.1, §3.7.4)

% ---- the enabledness of the refined outputs (docs/spec.md §3.7.2)
map ix_en_0: List(Client) # Bool -> Bool;
var ix_p_queue: List(Client); ix_p_free: Bool;
eqn ix_en_0(ix_p_queue, ix_p_free) = (ix_p_free && ix_p_queue != [] && (head(ix_p_queue)) == head(ix_p_queue));
map ix_quiet: List(Client) # Bool -> Bool;
var ix_p_queue: List(Client); ix_p_free: Bool;
eqn ix_quiet(ix_p_queue, ix_p_free) = !ix_en_0(ix_p_queue, ix_p_free);

act o_two: Client # Client;
    o_free: Client;

proc Core(
  phase: Client -> Phase,
  queue: List(Client),
  free: Bool
) =
   % c_ask input
sum c: Client .
    (((phase(c) == IDLE)) && ix_quiet(queue, free)) ->
    c_ask(c) .
    Core(phase = phase[c -> WAITING],
         queue = queue <| c)

 + % c_release input
sum c: Client .
    (((phase(c) == HOLDING)) && ix_quiet(queue, free)) ->
    c_release(c) .
    Core(phase = phase[c -> IDLE],
         free = true)

 + % c_grant output c_grant
(ix_en_0(queue, free)) ->
    c_grant((head(queue))) .
    Core(phase = phase[(head(queue)) -> HOLDING],
         queue = tail(queue),
         free = false)


  % mutual exclusion: never two clients holding the lock at once
  + sum c, d: Client . (c != d && phase(c) == HOLDING && phase(d) == HOLDING) -> o_two(c, d) . Core()
  % the lock is never free while a client holds it
  + sum c: Client . (free && phase(c) == HOLDING) -> o_free(c) . Core()
  + delta;

% env.mcrl2 -- the lock's environment (never generated): the three clients. A client
% asks when it is idle, waits until the lock grants it, and lets it go later.

act e_ask, e_release, e_grant: Client;
    ask, release, grant: Client;

% ins: the instance; ph: each client's phase, as the client sees it
proc Env(ins: Inst, ph: Client -> Phase) =
    sum c: Client . (ph(c) == IDLE) -> e_ask(c) . Env(ph = ph[c -> WAITING])
  + sum c: Client . e_grant(c) . Env(ph = ph[c -> HOLDING])
  + sum c: Client . (ph(c) == HOLDING) -> e_release(c) . Env(ph = ph[c -> IDLE]);

% Core's initial state.
proc CoreStart =
  Core(lambda c: Client . IDLE, [], true);

% ---- the system: Core and the environment agree on the instance, then run
act c_pick, e_pick, pick: Inst;
proc CoreSel = sum i: Inst . c_pick(i) . CoreStart;
     EnvSel = sum i: Inst . e_pick(i) . Env(i, lambda c: Client . IDLE);
     System =
  allow({ pick, ask, release, grant
, o_free, o_two
        },
  comm({ c_pick | e_pick -> pick,
         c_ask | e_ask -> ask,
         c_release | e_release -> release,
         c_grant | e_grant -> grant },
    CoreSel || EnvSel));

% three: the three clients of the sort Client; the lock has nothing an instance fixes.

init System;
