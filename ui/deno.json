{
  "nodeModulesDir": "auto",
  "tasks": {
    "tokens": "deno run -A scripts/stance-ui-tokens.ts --tokens tokens --out src/lib/ui/tokens.css",
    "dev": "deno task tokens && deno run -A npm:vite@8.3.5",
    "build": "deno task tokens && deno run -A npm:vite@8.3.5 build --logLevel warn",
    "check": "deno run -A npm:svelte-check@4.7.7 --tsconfig ./tsconfig.json",
    "test": "deno test -A test/"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.13"
  },
  "fmt": {
    "exclude": [
      "node_modules",
      "dist",
      ".stance-ui"
    ]
  },
  "lint": {
    "exclude": [
      "node_modules",
      "dist",
      ".stance-ui"
    ]
  }
}
